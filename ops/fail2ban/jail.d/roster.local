# Bans an IP after 10 failed logins within an hour, for a day. The server's
# own brake (5 per account and IP in 15 minutes) comes first; this catches
# someone who keeps trying. Caddy runs in the host network, so the ban (on
# port 443, and 8081 for the test instance) takes effect before the request
# reaches it. The server logs only IP addresses; Fail2Ban never looks a name
# up (usedns = no), so nothing in a log line can point a ban elsewhere.
[roster-auth]
enabled  = true
backend  = systemd
filter   = roster-auth
port     = 443,8081
protocol = tcp
usedns   = no
maxretry = 10
findtime = 1h
bantime  = 1d
