# /mnt/ssd/roster/app.env – the app's runtime configuration (rights 600).
# ops/install.sh creates it from this file if it does not exist yet and never
# overwrites it. Keys: docs/operations.md section 4. install.sh appends a
# TOTP_KEY (openssl rand -base64 32) if there is none; BUGS_TOKEN_HASH
# arrives with phase 4c.
PUBLIC_ORIGIN=https://{{ROSTER_HOST}}
LOG_LEVEL=info
