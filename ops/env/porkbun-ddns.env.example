# /etc/porkbun-ddns.env (root, rights 600) – only if the domain is at Porkbun
# (docs/operations.md, "Eigene Domain und DynDNS"). ops/install.sh installs
# the updater and its timer when this file exists. Never in the repository.
#   sudo install -m 600 /dev/null /etc/porkbun-ddns.env && sudo nano /etc/porkbun-ddns.env
# Porkbun: Account -> API Access -> create a key; at the domain, switch on
# "API Access".
PORKBUN_API_KEY=pk1_<key>
PORKBUN_SECRET_KEY=sk1_<secret>
DOMAIN=<domain>
# the names below the domain that point at this connection
HOSTS="mordheim ts"
