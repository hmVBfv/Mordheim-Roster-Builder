# /mnt/ssd/roster/staging.env – the test instance (home network only).
# Created by ops/install.sh if missing; never overwritten – except that
# install.sh gives it a TOTP_KEY of its own (never app.env's: the nightly
# restore test puts a copy of production in here) and ROSTER_STAGING=1,
# without which roster-cli refuses test-accounts (security review OPS-3).
PUBLIC_ORIGIN=http://{{ROSTER_LAN_IP}}:8081
LOG_LEVEL=info
ROSTER_STAGING=1
