# /mnt/ssd/roster/staging.env – the test instance (home network only).
# Created by ops/install.sh if missing; never overwritten – except its
# TOTP_KEY, which install.sh keeps equal to app.env's (the nightly restore
# test puts a copy of production in here).
PUBLIC_ORIGIN=http://{{ROSTER_LAN_IP}}:8081
LOG_LEVEL=info
