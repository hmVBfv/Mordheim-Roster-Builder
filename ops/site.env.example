# ~/server/roster/site.env – what only the Pi knows. Never in the repository.
# ops/install.sh reads it (KEY=value per line, nothing else is run); copy
# this file there and fill it in.

# the public hostname; its A record points at this connection
# (docs/operations.md section 11)
ROSTER_HOST=mordheim.<domain>
# the Pi in the home network: the test instance listens on <this>:8081
ROSTER_LAN_IP=192.168.178.<n>

# optional
# the account the service runs as (default: the one that runs sudo ops/install.sh)
# ROSTER_USER=<user>
# the mount the data lives on: Docker and the timers wait for it, and
# install.sh refuses to install while it is not mounted
# ROSTER_MOUNT=/mnt/ssd
# ROSTER_DATA=/mnt/ssd/roster
# ROSTER_IMAGE=ghcr.io/hmvbfv/mordheim-roster
