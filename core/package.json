{
  "name": "@mordheim/core",
  "private": true,
  "type": "module",
  "description": "Shared rules and campaign logic: no DOM, no globals. Used by the app (browser) and the server (Node).",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "immer": "^11.1.18"
  }
}
